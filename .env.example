# Local Windows entrypoint. Use 0.0.0.0 only if other trusted LAN devices
# should be able to reach the app and Windows Firewall is configured for it.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080

# Local PostgreSQL container. Use a long unique password; it is not exposed to
# the browser or published as a host port.
POSTGRES_DB=sari
POSTGRES_USER=sari
POSTGRES_PASSWORD=replace-with-a-long-random-password
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=300

# Initializes the empty local database with units, categories, and sample items.
# Repeated startups are safe because existing items are not duplicated.
SEED_SAMPLE_DATA=true
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Private backend-to-OCR authentication.
OCR_SERVICE_TOKEN=replace-with-a-different-long-random-token
OCR_GATEWAY_TIMEOUT_SECONDS=120
OCR_MAX_ATTEMPTS=3
OCR_GATEWAY_PLATFORM=linux/amd64
OCR_GATEWAY_PROVIDER=paddleocr

# CPU-friendly PaddleOCR defaults.
PADDLEOCR_VERSION=PP-OCRv4
PADDLEOCR_LANG=en
PADDLEOCR_DEVICE=cpu
PADDLEOCR_ENGINE=paddle_static
PADDLEOCR_DET_MODEL_NAME=PP-OCRv4_mobile_det
PADDLEOCR_REC_MODEL_NAME=en_PP-OCRv4_mobile_rec
PADDLEOCR_ENABLE_MKLDNN=false
PADDLEOCR_CPU_THREADS=2
PADDLEOCR_MKLDNN_CACHE_CAPACITY=10
PADDLEOCR_TEXT_DET_LIMIT_SIDE_LEN=1600
PADDLEOCR_TIMEOUT_SECONDS=90
PADDLEOCR_WARMUP_TIMEOUT_SECONDS=300
PADDLEOCR_DET_MODEL_DIR=
PADDLEOCR_REC_MODEL_DIR=
PADDLEOCR_DISABLE_MODEL_SOURCE_CHECK=true
